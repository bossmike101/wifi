# Database configuration (Neon PostgreSQL connection string)
DATABASE_URL="postgres://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# PalPluss Payment Integration
PALPLUS_API_KEY="your_palpluss_api_key_here"
PALPLUS_API_URL="https://api.palpluss.com/v1"
PALPLUS_CALLBACK_URL="https://billing-system.vercel.app/api/payments/callback"

# MikroTik HotSpot Router Settings
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT="8728"
MIKROTIK_USER="admin"
MIKROTIK_PASSWORD="your_router_password"

# Security & Secrets
SESSION_SECRET="super_secret_jwt_session_key_min_32_chars"
ENCRYPTION_KEY="aes_256_bit_encryption_secret_key"

# App URL
APP_URL="https://billing-system.vercel.app"
GEMINI_API_KEY=""
